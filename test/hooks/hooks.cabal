cabal-version:      3.14
name:               hooks
version:            0.1.0.0
synopsis:           Hooks build type test application
license:            BSD-3-Clause
author:             Rafał Kuźnia
maintainer:         rafal.kuznia@protonmail.com
build-type:         Hooks

extra-source-files: gresource/res1.xml gresource/text1.txt

custom-setup
  setup-depends:
    base,
    Cabal-hooks,
    cabal-gresource

common warnings
    ghc-options: -Wall

executable hooks-exe
    import:                 warnings
    hs-source-dirs:         app
    main-is:                Main.hs
    build-depends:
        base,
        gi-gio  >= 2.0.38 && < 2.1,
        gi-glib >= 2.0.30 && < 2.1,
        text ^>= { 2.1 },
    default-language:   Haskell2010
    default-extensions: ImportQualifiedPost
    x-gresource-xml-file:  gresource/res1.xml
    x-gresource-source-dir: gresource

test-suite hooks-test
    import:                 warnings
    type:                   exitcode-stdio-1.0
    hs-source-dirs:         app
    main-is:                Main.hs
    build-depends:
        base,
        gi-gio  >= 2.0.38 && < 2.1,
        gi-glib >= 2.0.30 && < 2.1,
        text ^>= { 2.1 },
    default-language:       Haskell2010
    default-extensions:     ImportQualifiedPost
    x-gresource-xml-file:   gresource/res1.xml
    x-gresource-source-dir: gresource
